PORT=5000
# Configurações da API do Spotify
# Para obter seu Client ID e Client Secret:
# 1. Acesse https://developer.spotify.com/dashboard
# 2. Crie um app e copie as credenciais abaixo
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Configurações de Envio de E-mail (SMTP / Nodemailer)
# Preencha com seu servidor SMTP (Gmail, Brevo, Resend, Mailtrap, Amazon SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@dominio.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM="DevSongs Pay <noreply@devsongs.com>"
